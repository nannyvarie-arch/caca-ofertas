# CAÇA OFERTA — Variáveis de ambiente de desenvolvimento (FASE 06)

# Identificador de usuário de desenvolvimento
# Usado pelo resolveCurrentUser quando não há autenticação real.
# Em produção, virá de auth real (FASE 10+).
# Não armazenar valor real nem secrets aqui.
DEV_USER_ID=

# URL do banco de dados (PostgreSQL/Supabase)
# Formato: postgresql://user:password@host:port/dbname
# Necessário para migration e integração real com banco.
# DATABASE_URL=

# Variáveis do Supabase Auth
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-key-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-key-service-role-aqui AQUI

# URL base da API (development)
API_BASE_URL=http://127.0.0.1:3333

# Caminho das saved ads na API
API_SAVED_ADS_PATH=/api/saved-ads