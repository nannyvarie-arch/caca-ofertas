// CAÇAOFERTA — modelo de dados (PostgreSQL + Prisma + Supabase)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  displayName String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  savedAds          SavedAd[]
  tags              Tag[]
  notes             Note[]
  searchHistory     SearchHistory[]
  extensionSessions ExtensionSession[]
  ads               Ad[]
  miningSearches    MiningSearch[]
  trackingEvents    TrackingEvent[]
  miningJobs        MiningJob[]
  ebooks            Ebook[]
  trackedOffers     TrackedOffer[]
  mediaTranscripts  MediaTranscript[]
  analysisQuotas    AnalysisQuota[]
  clonedPages       ClonedPage[]
  swipeDecisions    SwipeDecision[]
  swipeCollections  SwipeCollection[]
  keywordFavorites  KeywordFavorite[]
}

// FASE 06: `Ad` é o armazenamento canônico do contrato `NormalizedAd` (tokens
// normalizados em EN: status active/inactive/unknown, mediaType image/video/
// carousel/unknown). `platform` neste modelo é a PLATAFORMA DE ORIGEM (meta,
// google, ...), não o placement (facebook/instagram) — placements ficam em
// `platforms` (Json). `runningDays`, `destinationDomainName`, `creativeUrl` e
// `thumbnailUrl` foram adicionados na FASE 06 para honrar integralmente o
// contrato do parser. `destinationDomainName` é uma denormalização (mirror do
// NormalizedAd) para leitura simples nas listagens; a relação `Domain`/
// `destinationDomainId` da FASE 01 é preservada para futuras consultas.
model Ad {
  id                  String   @id @default(uuid())
  adLibraryId         String
  platform            String
  pageId              String?
  pageName            String?
  status              String?
  deliveryStartDate   DateTime?
  deliveryStopDate    DateTime?
  platforms           Json?
  mediaType           String?
  creativeText        String?
  headline            String?
  description         String?
  destinationUrl      String?
  destinationDomainId String?
  destinationDomainName String?
  adSnapshotUrl       String?
  cta                 String?
  runningDays         Int?
  creativeUrl         String?
  thumbnailUrl        String?
  userId              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  destinationDomain Domain?      @relation(fields: [destinationDomainId], references: [id])
  user              User?        @relation(fields: [userId], references: [id])
  creatives         AdCreative[]
  savedAds          SavedAd[]

  @@unique([adLibraryId, platform])
  @@index([destinationDomainId])
  @@index([pageId])
}

model AdCreative {
  id        String   @id @default(uuid())
  adId      String
  kind      String
  url       String
  mimeType  String?
  sizeBytes BigInt?
  createdAt DateTime @default(now())

  ad Ad @relation(fields: [adId], references: [id])

  @@index([adId])
}

model Domain {
  id        String   @id @default(uuid())
  domain    String   @unique
  countAds  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads      Ad[]
  savedAds SavedAd[]
}

model SavedAd {
  id             String   @id @default(uuid())
  userId         String
  adId           String
  adLibraryId    String
  pageId         String?
  domainId       String?
  noteText       String?
  isFavorite     Boolean  @default(false)
  statusSnapshot String?
  classification Int?     // 1 a 5 (classificação manual do usuário)
  score          Int?     // 0 a 100 (score de oportunidade calculado)
  savedAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id])
  ad     Ad        @relation(fields: [adId], references: [id])
  domain Domain?   @relation(fields: [domainId], references: [id])
  tags   AdTag[]
  notes  Note[]
  trackingEvents   TrackingEvent[]
  swipeCollections SwipeCollectionItem[]

  @@unique([userId, adLibraryId])
  @@index([userId])
  @@index([domainId])
  @@index([adLibraryId])
  @@index([isFavorite])
  @@index([classification])
  @@index([score])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  adTags AdTag[]

  @@unique([userId, name])
}

model AdTag {
  savedAdId String
  tagId     String
  createdAt DateTime @default(now())

  savedAd SavedAd @relation(fields: [savedAdId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([savedAdId, tagId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  savedAdId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  savedAd SavedAd @relation(fields: [savedAdId], references: [id])

  @@index([savedAdId])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model ExtensionSession {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  device       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── NOVOS MODELOS (FASE B2) ──────────────────────────────────────

model MiningSearch {
  id          String   @id @default(uuid())
  userId      String
  query       String
  type        String   @default("manual") // manual | automatic | domain
  niche       String?
  resultsCount Int     @default(0)
  savedCount  Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model TrackingEvent {
  id          String   @id @default(uuid())
  userId      String
  savedAdId   String
  eventType   String   // status_change | creative_change | domain_change
  field       String   // deliveryStartDate | deliveryStopDate | status | creativeText
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  savedAd SavedAd @relation(fields: [savedAdId], references: [id])

  @@index([savedAdId, createdAt(sort: Desc)])
  @@index([userId])
}

model MiningJob {
  id           String   @id @default(uuid())
  userId       String
  query        String
  niche        String?
  maxResults   Int      @default(50)
  status       String   @default("pending") // pending | running | completed | failed
  resultsFound Int      @default(0)
  savedCount   Int      @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// ─── E-BOOKS (FASE CRIAR E-BOOK) ─────────────────────────────────

model Ebook {
  id          String   @id @default(uuid())
  userId      String
  title       String
  subtitle    String?
  author      String?
  description String?
  themeId     String   @default("editorial")
  coverConfig Json     @default("{}")
  content     Json     @default("[]")
  status      String   @default("draft") // draft | ready
  pageCount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  assets EbookAsset[]

  @@index([userId, updatedAt(sort: Desc)])
}

model EbookAsset {
  id        String   @id @default(uuid())
  ebookId   String
  userId    String
  url       String
  fileName  String?
  kind      String   @default("upload") // upload | mockup | generated
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@index([ebookId])
}

// ─── RASTREAMENTO DE OFERTAS ────────────────────────────────────

model TrackedOffer {
  id             String   @id @default(uuid())
  userId         String
  adLibraryId    String
  pageId         String?
  pageName       String?
  label          String?
  status         String   @default("collecting") // collecting | scaling | dropping | dead | unknown
  adCountCurrent Int      @default(0)
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  snapshots AdCountSnapshot[]

  @@unique([userId, adLibraryId])
  @@index([userId])
  @@index([status])
}

model AdCountSnapshot {
  id             String   @id @default(uuid())
  trackedOfferId String
  adCount        Int
  activeCount    Int      @default(0)
  newCreatives   Int      @default(0)
  metadata       Json?
  takenAt        DateTime @default(now())

  trackedOffer TrackedOffer @relation(fields: [trackedOfferId], references: [id], onDelete: Cascade)

  @@index([trackedOfferId, takenAt(sort: Desc)])
}

// ─── TRANSCRIÇÃO DE MÍDIAS ──────────────────────────────────────

model MediaTranscript {
  id         String   @id @default(uuid())
  userId     String
  sourceType String   @default("upload") // upload | savedAd
  sourceRef  String?
  fileName   String?
  language   String   @default("pt")
  text       Json     @default("[]") // [{start, end, text}]
  status     String   @default("pending") // pending | transcribing | done | error
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// ─── ANÁLISE DE TRÁFEGO (COTA) ──────────────────────────────────

model AnalysisQuota {
  id           String   @id @default(uuid())
  userId       String
  domain       String
  usedToday    Int      @default(1)
  date         DateTime @default(now()) // date only (start of day)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, domain, date])
  @@index([userId])
}

// ─── CLONAR PÁGINAS ─────────────────────────────────────────────

model ClonedPage {
  id          String   @id @default(uuid())
  userId      String
  sourceUrl   String
  mode        String   @default("sales") // sales | quiz
  title       String?
  structure   Json     @default("{}")
  assets      Json     @default("[]")
  status      String   @default("pending") // pending | captured | edited | exported
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// ─── SWIPE / COLEÇÕES ───────────────────────────────────────────

model SwipeDecision {
  id        String   @id @default(uuid())
  userId    String
  adId      String
  decision  String   // save | discard | favorite
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, adId])
  @@index([userId, createdAt(sort: Desc)])
}

model SwipeCollection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user   User                  @relation(fields: [userId], references: [id])
  items  SwipeCollectionItem[]

  @@index([userId])
}

model SwipeCollectionItem {
  collectionId String
  savedAdId    String
  createdAt    DateTime @default(now())

  collection SwipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedAd    SavedAd         @relation(fields: [savedAdId], references: [id], onDelete: Cascade)

  @@id([collectionId, savedAdId])
}

// ─── MINERAÇÃO DIÁRIA / LOW TICKET ─────────────────────────────

model Offer {
  id                String   @id @default(uuid())
  adLibraryId       String
  pageId            String?
  pageName          String?
  advertiserName    String?
  primaryDomain     String?
  funnelUrl         String?
  adLibraryUrl      String?
  niche             String?
  subniche          String?
  country           String?
  language          String?
  mediaType         String?
  isLowTicket       Boolean  @default(false)
  lowTicketSignals  Json     @default("[]")
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  lastRunDate       DateTime?
  status            String   @default("coletando") // nova | subindo | estavel | caindo | morta | coletando
  qualification     String?  // qualificada | pendente | descartada
  isSaved           Boolean  @default(false)
  isFavorite        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots OfferSnapshot[]

  @@unique([adLibraryId])
  @@index([status])
  @@index([niche])
  @@index([isLowTicket])
  @@index([lastRunDate])
  @@index([lastSeenAt(sort: Desc)])
}

model OfferSnapshot {
  id           String   @id @default(uuid())
  offerId      String
  activeAds    Int      @default(0)
  totalAds     Int      @default(0)
  creativeCount Int     @default(0)
  runningDays  Int      @default(0)
  metadata     Json?
  takenAt      DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, takenAt(sort: Desc)])
}

model DailyMiningRun {
  id              String   @id @default(uuid())
  runDate         DateTime @unique
  status          String   @default("pending") // pending | running | done | failed
  keywordsUsed    Json     @default("[]")
  adsFound        Int      @default(0)
  offersUpserted  Int      @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([runDate(sort: Desc)])
}

// ─── PALAVRAS-CHAVE / KEYWORD FAVORITES ────────────────────────

model KeywordFavorite {
  id        String   @id @default(uuid())
  userId    String
  keyword   String
  niche     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, keyword])
  @@index([userId])
}