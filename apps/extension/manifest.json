{
  "manifest_version": 3,
  "name": "CaçaOferta",
  "version": "0.1.0",
  "description": "Encontre ofertas. Analise anúncios. Descubra oportunidades.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CaçaOferta",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*",
        "https://www.facebook.com/ads/library",
        "https://web.facebook.com/ads/library/*",
        "https://web.facebook.com/ads/library"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "http://127.0.0.1:3333/*",
    "http://localhost:3333/*"
  ]
}