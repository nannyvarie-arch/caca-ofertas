{
  "name": "@caca-oferta/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend/API do CaçaOferta (Node.js + TypeScript + Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "pnpm --filter @caca-oferta/database build && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caca-oferta/database": "workspace:*",
    "@caca-oferta/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "fastify": "^5.12.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}